rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isBlocked() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && !isBlocked() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        myProfile().data.role == 'admin';
    }

    function sameCompany(companyId) {
      return isSignedIn() && !isBlocked() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        myProfile().data.companyId == companyId;
    }

    // ── Companies ────────────────────────────────────────────────
    match /companies/{companyId} {
      allow read: if isSignedIn() && !isBlocked() && (resource.data.adminUid == request.auth.uid || sameCompany(companyId));
      allow create: if isAdmin();
      allow update: if isSignedIn() && !isBlocked() && (resource.data.adminUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Users / profiles ─────────────────────────────────────────
    // Allow users to read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && !isBlocked() && request.auth.uid == userId;
      // Allow admins to read/write all user profiles
      allow read, write: if isAdmin();
    }

    // Allow admins to read all users (for listing)
    match /users {
      allow read: if isAdmin();
    }

    // ── Session documents ────────────────────────────────────────
    // Users can read/write their own sessions; admins can purge anyone's on delete.
    match /users/{userId}/sessions/{sessionId} {
      allow read, write: if request.auth != null && !isBlocked() && request.auth.uid == userId;
      // Allow admins to read all sessions
      allow read: if isAdmin();
      // Allow admins to delete all sessions (employee removal)
      allow write: if isAdmin();
    }

    // Admins can read all sessions collections
    match /users/{userId}/sessions {
      allow read: if isAdmin();
    }

    // Users can read/write their own breaks; admins can purge anyone's on delete.
    match /users/{userId}/sessions/{sessionId}/breaks/{breakId} {
      allow read, write: if request.auth != null && !isBlocked() && request.auth.uid == userId;
      // Allow admins to read all breaks
      allow read: if isAdmin();
      // Allow admins to delete all breaks (employee removal)
      allow write: if isAdmin();
    }

    // Admins can read all breaks collections
    match /users/{userId}/sessions/{sessionId}/breaks {
      allow read: if isAdmin();
    }

    // ── Leave requests ───────────────────────────────────────────
    match /leaveRequests/{leaveRequestId} {
      // Employees can read their own requests; admins read all
      allow read: if isAdmin() ||
        (request.auth != null && !isBlocked() && resource.data.employeeId == request.auth.uid);
      // Employees can create their own requests
      allow create: if request.auth != null && !isBlocked() && request.resource.data.employeeId == request.auth.uid;
      // Only admins can update (approve/reject/notes) or delete
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Live status / presence ─────────────────────────────────────────────
    // Employees write their current status (working/break/offline); any signed-in
    // user may read presence so the admin's filtered collection query is never
    // blocked by a single doc missing its companyId.
    match /liveStatus/{uid} {
      allow read: if isSignedIn() && !isBlocked();
      allow write: if isSignedIn() && !isBlocked() && (request.auth.uid == uid || isAdmin());
    }

    // Notes/Announcements
    match /notes/{noteId} {
      // Admins can read/write all notes
      allow read, write: if isAdmin();
      // Users can read/write notes sent to them or to all
      allow read, write: if request.auth != null && !isBlocked() &&
        (resource.data.recipientId == request.auth.uid || resource.data.recipientId == 'all');
    }

    // Personal Notes
    match /personalNotes/{noteId} {
      // Users can read/write their own personal notes; admins can purge any on delete
      allow read, write: if request.auth != null && !isBlocked() &&
        (isAdmin() || request.auth.uid == resource.data.userId);
    }

    // Subscriptions
    match /subscriptions/{subscriptionId} {
      // Allow authenticated users to read/write subscriptions
      allow read, write: if request.auth != null && !isBlocked();
    }

    // ── Blocked accounts ─────────────────────────────────────────
    // The account itself may read its own record (so the app can show the
    // "disabled" toast); admins can read the full list and manage entries.
    match /blockedUsers/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // ── Notifications ──────────────────────────────────────────
    // Recipients read their own feed and mark items read; anyone in the same
    // company (verified via trusted get()) may push a notification to a
    // colleague's feed (leave requests, notes, approvals…).
    match /notifications/{uid}/items/{itemId} {
      allow read: if request.auth != null && request.auth.uid == uid && !isBlocked();
      allow create: if isSignedIn() && !isBlocked() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        exists(/databases/$(database)/documents/users/$(uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId ==
          get(/databases/$(database)/documents/users/$(uid)).data.companyId;
      allow update: if request.auth != null && request.auth.uid == uid && !isBlocked();
    }
  }
}